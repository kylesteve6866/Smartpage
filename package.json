{
  "name": "academic-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:search": "pagefind --site dist",
    "build": "npm run build:astro && npm run build:search",
    "translate": "node scripts/translate-content.mjs",
    "translate:auto": "node scripts/translate-content.mjs --skip-if-unconfigured",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cross-env": "^10.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
