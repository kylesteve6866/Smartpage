---
import { getCollection } from 'astro:content';
import ProjectDetail from '@/components/ProjectDetail.astro';
import { isPublished } from '@/utils/content';
export async function getStaticPaths(){return (await getCollection('projects')).filter((x)=>x.data.locale==='zh'&&isPublished(x)).map((project)=>({params:{slug:project.data.slug},props:{project}}));}
const {project}=Astro.props;
---
<ProjectDetail {project} locale="zh" />
