---
interface Props { eyebrow?: string; title: string; description?: string; link?: string; linkLabel?: string }
const { eyebrow, title, description, link, linkLabel } = Astro.props;
---
<header class="section-header" data-reveal="fade-up">
  <div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2 class="display-title">{title}</h2>{description && <p class="description">{description}</p>}</div>
  {link && linkLabel && <a class="text-link" href={link}>{linkLabel}</a>}
</header>
<style>.section-header{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:clamp(2rem,5vw,4rem)}.description{max-width:42rem;margin:1rem 0 0;color:var(--color-muted)}@media(max-width:640px){.section-header{align-items:start;flex-direction:column;gap:1rem}}</style>
