---
import type { Locale } from '@/types';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button class="back-top" type="button" aria-label={locale === 'zh' ? '返回顶部' : 'Back to top'} title={locale === 'zh' ? '返回顶部' : 'Back to top'}>↑</button>
<script>
  const setupBackTop=()=>document.querySelectorAll<HTMLButtonElement>('.back-top').forEach((b)=>{if(b.dataset.ready)return;b.dataset.ready='1';const show=()=>b.classList.toggle('show',scrollY>700);addEventListener('scroll',show,{passive:true});show();b.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));});setupBackTop();document.addEventListener('astro:after-swap',setupBackTop);
</script>
<style>.back-top{position:fixed;z-index:60;right:1rem;bottom:1rem;width:2.7rem;height:2.7rem;border:1px solid var(--color-line);border-radius:50%;background:var(--color-elevated);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:var(--shadow-sm);opacity:0;pointer-events:none;transform:translateY(8px);transition:all var(--transition-fast);cursor:pointer}.back-top.show{opacity:1;pointer-events:auto;transform:none}</style>
