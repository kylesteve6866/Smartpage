---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/types';
import { formatDate } from '@/utils/content';
interface Props { items: CollectionEntry<'news'>[]; locale: Locale }
const { items, locale } = Astro.props;
---
<ol class="news-list">{items.map((item)=><li data-reveal="fade-up"><time datetime={item.data.date.toISOString()}>{formatDate(item.data.date,locale)}</time><div><h3>{item.data.link ? <a href={item.data.link}>{item.data.title}</a> : item.data.title}</h3><p>{item.data.description}</p></div></li>)}</ol>
<style>.news-list{margin:0;padding:0;list-style:none}.news-list li{display:grid;grid-template-columns:10rem 1fr;gap:2rem;padding:1.4rem 0;border-top:1px solid var(--color-line)}time{color:var(--color-faint);font-size:var(--text-sm);font-variant-numeric:tabular-nums}.news-list h3{margin:0;font-size:var(--text-base)}.news-list h3 a{text-decoration:none}.news-list p{margin:.35rem 0 0;color:var(--color-muted);font-size:var(--text-sm)}@media(max-width:600px){.news-list li{grid-template-columns:1fr;gap:.35rem}}</style>
