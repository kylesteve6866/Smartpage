---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/types';
import { assetUrl, getLocalizedPath } from '@/utils/urls';
interface Props { project: CollectionEntry<'projects'>; locale: Locale; index?: number }
const { project, locale, index = 0 } = Astro.props;
---
<article class="project-card" data-reveal="fade-up">
  <a class="project-media" href={getLocalizedPath(locale, `/projects/${project.data.slug}/`)} tabindex="-1">
    {project.data.image ? <img src={assetUrl(project.data.image)} alt={project.data.imageAlt} width="1400" height="900" loading="lazy" /> : <div class="project-placeholder" aria-hidden="true"><span>{String(index + 1).padStart(2,'0')}</span></div>}
  </a>
  <div class="project-copy"><p class="eyebrow">{project.data.role || (locale === 'zh' ? '研究项目' : 'Research project')}</p><h3><a href={getLocalizedPath(locale, `/projects/${project.data.slug}/`)}>{project.data.title}</a></h3><p>{project.data.description}</p><div class="tags">{project.data.tags.map((tag)=><span class="chip">{tag}</span>)}</div></div>
</article>
<style>.project-card{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(17rem,.8fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;padding-block:clamp(2rem,6vw,5rem);border-top:1px solid var(--color-line)}.project-media{display:block;overflow:hidden;aspect-ratio:16/10;border-radius:var(--radius-md);background:var(--color-surface)}.project-media img{width:100%;height:100%;object-fit:cover;transition:transform var(--transition-base)}.project-media:hover img{transform:scale(1.015)}.project-placeholder{width:100%;height:100%;display:grid;place-items:center;background:linear-gradient(140deg,var(--color-accent-soft),var(--color-surface))}.project-placeholder span{font-size:clamp(4rem,10vw,8rem);font-weight:700;letter-spacing:-.08em;color:var(--color-accent);opacity:.5}.project-copy h3{margin:0 0 1rem;font-size:var(--text-2xl);line-height:1.05;letter-spacing:-.045em}.project-copy h3 a{text-decoration:none}.project-copy>p:not(.eyebrow){color:var(--color-muted)}.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.25rem}@media(max-width:760px){.project-card{grid-template-columns:1fr}.project-copy h3{font-size:var(--text-xl)}}
</style>
